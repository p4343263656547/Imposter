// game.js — Game screen logic: clue feed, turn management, player sidebar

window.Game = (() => {
  let roomState = null;

  function initScreen() {
    document.getElementById('btn-submit-clue').addEventListener('click', submitClue);
    document.getElementById('clue-input').addEventListener('keydown', e => {
      if (e.key === 'Enter') submitClue();
    });
  }

  function update(state) {
    roomState = state;
    const myId = GameSocket.getId();

    // Update player sidebar
    const playerList = document.getElementById('game-player-list');
    playerList.innerHTML = '';
    state.players.forEach(p => {
      const card = UI.buildPlayerCard(p, {
        isHost: p.id === state.hostId,
        isCurrentTurn: p.id === state.currentTurnId,
        myId,
        showEliminated: true,
      });
      playerList.appendChild(card);
    });

    // Turn banner
    const currentPlayer = state.players.find(p => p.id === state.currentTurnId);
    document.getElementById('turn-name').textContent = currentPlayer
      ? (currentPlayer.id === myId ? '⭐ YOU' : currentPlayer.name)
      : '—';

    // Round
    document.getElementById('current-round').textContent = state.round;

    // Hint
    document.getElementById('game-hint').textContent = window._myHint || '—';

    // Input zone visibility
    const isMyTurn = state.currentTurnId === myId;
    document.getElementById('clue-input-zone').style.display = isMyTurn ? 'flex' : 'none';
    document.getElementById('waiting-turn').style.display = isMyTurn ? 'none' : 'flex';

    if (isMyTurn) {
      document.getElementById('clue-input').focus();
      document.getElementById('turn-banner').classList.add('my-turn');
    } else {
      document.getElementById('turn-banner').classList.remove('my-turn');
    }

    // Clue feed
    renderClueFeed(state.clues);
  }

  function renderClueFeed(clues) {
    const feed = document.getElementById('clue-feed');
    if (!clues || clues.length === 0) {
      feed.innerHTML = '<div class="feed-empty">Waiting for clues...</div>';
      return;
    }

    // Group by round
    const byRound = {};
    clues.forEach(c => {
      if (!byRound[c.round]) byRound[c.round] = [];
      byRound[c.round].push(c);
    });

    feed.innerHTML = '';
    Object.keys(byRound).sort().forEach(round => {
      const header = document.createElement('div');
      header.className = 'clue-round-header';
      header.textContent = `— ROUND ${round} —`;
      feed.appendChild(header);

      byRound[round].forEach(c => {
        const bubble = document.createElement('div');
        bubble.className = 'clue-bubble';
        bubble.dataset.player = c.playerId;
        if (c.playerId === GameSocket.getId()) bubble.classList.add('my-clue');
        bubble.innerHTML = `
          <span class="clue-player">${c.playerName}</span>
          <span class="clue-word">${c.clue}</span>
        `;
        feed.appendChild(bubble);
      });
    });

    // Scroll to bottom
    feed.scrollTop = feed.scrollHeight;
  }

  function addClue(clueEntry) {
    if (roomState) {
      roomState.clues.push(clueEntry);
      renderClueFeed(roomState.clues);
    }
  }

  function submitClue() {
    const input = document.getElementById('clue-input');
    const clue = input.value.trim().split(/\s+/)[0]; // enforce single word
    if (!clue) { UI.toast('Enter one word!', 'warn'); return; }
    GameSocket.emit('submit_clue', { clue });
    input.value = '';
    // Disable until next turn
    input.disabled = true;
    document.getElementById('btn-submit-clue').disabled = true;
    setTimeout(() => {
      input.disabled = false;
      document.getElementById('btn-submit-clue').disabled = false;
    }, 1000);
  }

  function enableInput(enable) {
    document.getElementById('clue-input').disabled = !enable;
    document.getElementById('btn-submit-clue').disabled = !enable;
  }

  return { initScreen, update, addClue, enableInput };
})();
